// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

/*
 * Sipeed NanoKVM-Pro (Axera AX630C) -- minimal mainline board DT (#74).
 *
 * Board facts only: memory size, the firmware carveouts, the console, and a
 * cmdline that satisfies the U-Boot contract. Peripherals arrive with their
 * drivers (see ax630c.dtsi).
 */

#include <dt-bindings/gpio/gpio.h>

#include "ax630c.dtsi"

/ {
	model = "Sipeed NanoKVM-Pro";
	compatible = "sipeed,nanokvm-pro", AX630C_SOC_COMPAT;

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac;
	};

	/*
	 * The heartbeat LED (#81). GPIO0_A23 on pad SD_PWR_EN, active high.
	 *
	 * No linux,default-trigger: the bring-up initramfs blinks this line
	 * itself through /dev/mem, because on a kernel with no rootfs it is the
	 * only channel that says "userspace was reached" to a human in the
	 * room. A kernel heartbeat trigger would fight it. What the node is
	 * for meanwhile is ownership -- it is the cheapest end-to-end proof
	 * that gpio-ranges reached the pin controller, since a claimed line
	 * shows up in both /sys/kernel/debug/gpio and pinmux-pins.
	 *
	 * The same line is `reset-gpio` of the vendor DT's panel_dsi node.
	 * That node is disabled on this board and has no mainline counterpart,
	 * but do not be surprised to find GPIO0_A23 described as a panel reset
	 * elsewhere.
	 */
	leds {
		compatible = "gpio-leds";

		led-heartbeat {
			label = "sys-heartbeat";
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";

		/*
		 * U-Boot overwrites this from its `bootargs` env at `booti`
		 * (fdt_chosen), so the string here is a documented default, not
		 * the authority. Two traps it encodes (docs/mainline-port.md
		 * section 5):
		 *
		 *  - blkdevparts= IS U-Boot's partition table. U-Boot parses it
		 *    out of its own env; if the clause is missing it silently
		 *    resets the env to the vendor BOOTARGS_EMMC. Never ship a
		 *    cmdline without it.
		 *  - fdt_chosen needs free space in the blob or boot_prep_linux
		 *    calls hang(). pkgs/dtb-mainline.nix passes `dtc -p 4096`
		 *    so a longer env string always fits.
		 *
		 * No mem= clause: the memory node below is correct, unlike the
		 * vendor DT's, so the kernel does not need to be told twice.
		 * U-Boot appends its own mem= from the board-id ADC read; that
		 * is harmless and will be dropped when U-Boot moves (#26).
		 *
		 * The clause below is the MINIMAL layout (#89 rung 4): six
		 * partitions, no A/B twins, no ddrinit/optee/logo/kernel/dtb.
		 * nixos/lib/emmc-layout.nix is where it is defined and it
		 * ASSERTS that this string matches, so the two cannot drift.
		 */
		bootargs = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x4880000 loglevel=8 root=/dev/mmcblk0p6 rootfstype=ext4 rw rootwait blkdevparts=mmcblk0:768K(spl),256K(atf),1536K(uboot),256K(env),275M(boot),-(rootfs)";
	};

	/*
	 * 1 GiB. The vendor DT claims 3 GiB (0xC0000000) and relies on U-Boot's
	 * mem= to cut it down -- wrong for every NanoKVM-Pro variant. Board
	 * variants differ only in this node.
	 */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* TF-A 2.7. no-map: secondary CPU bring-up runs from here. */
		atf@40040000 {
			reg = <0x0 0x40040000 0x0 0x40000>;
			no-map;
		};

		/*
		 * OP-TEE 3.21, firewalled by the ATF. Nothing in our stack
		 * calls it (no TEEC_ or tee_ symbol in any component), but the region
		 * must stay reserved regardless -- the secure world is using
		 * it whether or not Linux talks to it.
		 */
		optee@44200000 {
			reg = <0x0 0x44200000 0x0 0x2000000>;
			no-map;
		};

		/*
		 * The vendor kernel's pstore zones. Kept reserved, and untouched,
		 * so that a mainline excursion on slot B does not destroy the
		 * crash history of the slot-A system that has to diagnose it.
		 * The vendor DT declares one ramoops region here, 0xf0000 long,
		 * whose zones only reach 0x480e0000 -- everything past that is
		 * reserved on both sides and used by neither, which is why the
		 * two regions below can live there.
		 */
		vendor-pstore@48000000 {
			reg = <0x0 0x48000000 0x0 0xd4000>;
			no-map;
		};

		/*
		 * Our ramoops, deliberately NOT at the head of the window: the
		 * vendor kernel's own ramoops zaps every zone it owns at its
		 * probe, about 1.5 s into the boot that would read ours. A log
		 * written at 0x48000000 is destroyed by the very kernel meant to
		 * recover it (measured 2026-09-06).
		 *
		 * More precisely, this sits inside the DATA area of the vendor
		 * ramoops' ftrace zone (0x480d0000-0x480f0000). Nothing writes
		 * that data unless pstore function tracing is switched on, and
		 * the zap at the vendor's probe rewrites only the zone's own
		 * 12-byte header at 0x480d0000 -- which is why this region
		 * starts at 0x480d4000 and not at that header. Confirmed on
		 * hardware: a full mainline boot log written here was still
		 * intact after the vendor kernel had booted and read it.
		 *
		 * mem-type 1 is uncached. On a board whose only reset is a
		 * watchdog or a raw chip reset, neither of which writes back
		 * dirty cache lines, a cacheable pstore zone is a log that
		 * evaporates in exactly the case it exists for.
		 *
		 * Both sizes are powers of two because ramoops rounds them down
		 * to one anyway, so a DT that has to be simulated to know its
		 * own layout is worse than a DT that is simply explicit. 0x8000
		 * console and the 0x4000 remainder as two 0x2000 dump records.
		 *
		 * **The console zone must hold a WHOLE boot log.** At 0x4000 it
		 * did not: a full appliance boot is 25478 bytes of console text
		 * (measured), the ring kept only the last 16 KB, and the MDIO
		 * bus scan at t=1 s -- the thing rung 2q had to see -- had been
		 * overwritten by the time the board reset. 0x8000 covers it.
		 *
		 * The region also stops at 0x480e0000 on purpose: a slot-B
		 * excursion is read back by a slot-A system that may still be
		 * running an OLDER dtb, whose own ramoops owns 0x480e0000
		 * upwards and zeroes it on the very boot that is supposed to
		 * recover the log. Keep this window disjoint from every address
		 * the reader might claim.
		 *
		 * This is the only channel that survives when userspace never
		 * runs: the console zone holds the boot log from the first
		 * printk (pstore's console registers with CON_PRINTBUFFER, so
		 * the buffered log is replayed into it), and the dump zone holds
		 * the panic.
		 *
		 * Reading it back is NOT `ls /sys/fs/pstore`. systemd-pstore
		 * archives every record into /var/lib/systemd/pstore and unlinks
		 * it about ten seconds into each boot, under fixed names that the
		 * next boot overwrites -- and the unlink calls
		 * ramoops_pstore_erase(), which zaps the LIVE console zone.
		 */
		ramoops@480d4000 {
			compatible = "ramoops";
			reg = <0x0 0x480d4000 0x0 0xc000>;
			console-size = <0x8000>;
			record-size = <0x2000>;
			mem-type = <1>;
		};

		/*
		 * The bring-up initramfs's kernel-log stash
		 * (pkgs/kernel-mainline/initramfs/bringup-init.c). Mapped, not
		 * no-map, and written through an O_SYNC /dev/mem mapping, which
		 * arm64 makes write-combining -- so it reaches DRAM without
		 * depending on a cache flush that no reset on this SoC performs.
		 *
		 * Read it back from the vendor system after the excursion:
		 *   dd if=/dev/mem bs=4096 skip=$((0x480e8000/4096)) count=8
		 * The first 32 bytes are a magic string and a u32 length at +24.
		 */
		bringup-log@480e8000 {
			reg = <0x0 0x480e8000 0x0 0x8000>;
		};

		/*
		 * The video carveouts (#83), at the ADDRESSES THE 4.19 IMAGE
		 * HAS BEEN DMAing TO SINCE #53 -- 0x73800000-0x7FFFFFFF, the
		 * top 200 MiB of the GiB. On 4.19 a shell loader computed this
		 * split from the board-id ADC read and passed it to three
		 * modules as parameters; here it is three DT nodes, and
		 * `compute_mem_map` has no counterpart at all.
		 *
		 * They are ABOVE what the kernel treats as RAM, and that is
		 * deliberate rather than accidental. The command line carries
		 * `mem=512M` (pkgs/extlinux.nix), so memblock ends at
		 * 0x60000000 and none of this is System RAM; `no-map` regions
		 * outside memory are explicitly supported
		 * (drivers/of/of_reserved_mem.c: "don't worry if the region
		 * isn't memory as it won't be mapped"), and the DMA pool code
		 * memremaps them write-combining, which is exactly what
		 * dma_declare_coherent_memory() did on 4.19. So this works
		 * whatever `mem=` ends up being, and raising it later cannot
		 * silently eat these regions.
		 *
		 * no-map on all three, not `reusable`: the WDMA and the encoder
		 * consume bus addresses out of a register program, so the
		 * region has to be at a fixed place, and the kernel must never
		 * hand any of it to the page allocator.
		 */

		/*
		 * Encoder frame buffers. NOT a dma pool -- the kernel never
		 * maps this at all; the driver hands out bus addresses and
		 * userspace mmaps them write-combining through the char
		 * device. 136 MiB covers the 4K floorplan (91 MiB with the
		 * prover input region, 59 MiB without; 1080p is 23 MiB).
		 */
		venc_framebuf: venc-framebuf@73800000 {
			reg = <0x0 0x73800000 0x0 0x8800000>;
			no-map;
		};

		/*
		 * Capture buffers. 56 MiB fits three 4K YUYV frames
		 * (3840*2160*2 = 15.8 MiB each), which is what the queue needs
		 * to rotate without dropping.
		 */
		capture_pool: capture-pool@7c000000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x7c000000 0x0 0x3800000>;
			no-map;
		};

		/*
		 * The VCMD engine's own three coherent pools (command, status,
		 * register), 2 MiB each plus slack.
		 */
		venc_cmdbuf: venc-cmdbuf@7f800000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x7f800000 0x0 0x800000>;
			no-map;
		};
	};
};

/*
 * The video path (#83). Three nodes enabled and one graph edge closed: the
 * LT6911UXC's MIPI output into the SoC's CSI-2 receiver.
 *
 * The lane map is the board's wiring and it lives here, in the endpoint, which
 * is the only place a board fact belongs. `clock-lanes = <2>` and
 * `data-lanes = <0 1 3 4>` are the PHYSICAL lane slots feeding the logical
 * clock and the four logical data lanes -- device-confirmed 2026-09-01 from
 * the vendor's own streaming state (the D-PHY swap mirror reads 0x0005c540;
 * a naive 0..5 map reads 0x00053940 and produces a locked PHY that forwards
 * short packets and no pixel data).
 */
&mipi_rx {
	status = "okay";
};

&csi2_port0 {
	csi2_in: endpoint {
		remote-endpoint = <&lt6911_out>;
		clock-lanes = <2>;
		data-lanes = <0 1 3 4>;
	};
};

&vin {
	status = "okay";
	memory-region = <&capture_pool>;
};

&venc {
	status = "okay";
	memory-region = <&venc_cmdbuf>, <&venc_framebuf>;
	memory-region-names = "cmdbuf", "framebuf";
};

/*
 * Ethernet (#77). A Realtek RTL8211F at MDIO address 1, RGMII.
 *
 * NOT a JLSemi JL2101, whatever the vendor DT says. That DT declares
 * `compatible = "ethernet-phy-id937c.4030"` on this node, which makes the MDIO
 * core skip the bus read entirely and bind the vendor's JLSemi driver to
 * whatever is actually there. Read over MDIO on the running board 2026-09-06,
 * the part answers PHYID1 = 0x001c, PHYID2 = 0xc916 -- Realtek's RTL8211F, and
 * mainline's own realtek driver claims it. So there is no JL2101 driver to
 * write; that half of #77's scope simply does not exist on this hardware.
 *
 * Hence no `compatible` on the PHY node here: the scan reads the real ID.
 *
 * phy-mode = "rgmii-id", and this is the whole ballgame. The RTL8211F's two
 * 2 ns delays come up ENABLED from pin-strapping (measured: page 0xd08 TXCR
 * bit 8 = 1, RXCR bit 3 = 1 on the running vendor system), and the vendor's
 * JLSemi driver never writes them -- its RGMII block is compiled out. Mainline's
 * realtek driver is not so passive: rtl8211f_config_rgmii_delay() writes both
 * bits to match phy-mode, so "rgmii" DISABLES the delays the board is built
 * around. That failure looks like success -- the link trains and reports
 * 1 Gbps/full -- and then no frame survives. It cost one boot cycle to find.
 *
 * The twenty `jl2xxx,*` tuning properties the vendor DT carries are inert even
 * on the driver they were written for (each is gated behind a compile-time
 * operation mode that is NONE or C_MACRO), and irrelevant here regardless.
 */
&gmac {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&phy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac_pins>;

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * RSTn is GPIO1_A27, pad EPHY_RSTN, active low. The MDIO core
		 * pulses it when this device registers -- before it reads the
		 * PHY's ID, which is the only ordering that matters. Firmware
		 * does not drive it: on a cold or chip reset every GPIO line
		 * comes up an input, so RSTn is left to whatever the board
		 * pulls it to.
		 *
		 * The glue used to do this itself by poking the GPIO block's
		 * line word through an address in DT, because there was no
		 * GPIO controller to name (#77). #81 gave it one, and the two
		 * delays below are the ones that glue used.
		 */
		phy1: ethernet-phy@1 {
			reg = <1>;
			reset-gpios = <&gpio1 27 GPIO_ACTIVE_LOW>;
			reset-assert-us = <15000>;
			reset-deassert-us = <75000>;
		};
	};
};

/*
 * ATX (#81). Four lines to the host's front-panel header, driven from
 * userspace: the KVM's whole reason to exist is pressing a button on a machine
 * that is not this one.
 *
 * They are named rather than hogged. A hog would claim them for the kernel and
 * put them out of reach of the chardev, and userspace is the only thing that
 * knows when a press should happen. Naming them means tools/nanokvm-gpio can
 * ask for "atx-power" instead of a global number that moves whenever a
 * gpiochip probes in a different order.
 *
 * This is also the root fix for the SW_PWR trap (docs/mini-display.md). SW_PWR
 * is GPIO0_A7 on pad VI_D7, which is also a capture data pad; the vendor's
 * capture stack re-muxed it at every pipeline init and its GPIO driver stubbed
 * chip->request, so nothing ever muxed it back and the value file went on
 * echoing a latch that reached no ball. Here, requesting the line programs the
 * mux (gpio-ranges -> gpio_request_enable), and the pin controller's strict
 * mode means a peripheral state cannot take the pad while a line is held. The
 * rule that keeps it that way: whatever declares the capture pin group in #83
 * must not list VI_D7.
 *
 * The power LED sense is inverted -- the host is ON when the line reads 0 --
 * which is a property of the board, not of the driver, so it is declared here
 * as GPIO_ACTIVE_LOW and every consumer sees "1 means on".
 */
&gpio0 {
	gpio-line-names =
		"", "", "", "", "", "", "", "atx-power",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "sys-heartbeat";
};

&gpio1 {
	gpio-line-names =
		"", "", "", "atx-reset";
};

&gpio2 {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "atx-hdd-led", "atx-power-led";
};

/*
 * The LT6911UXC HDMI receiver (#81), the front end of the whole capture path.
 *
 * The vendor has no DT node for this part at all: its driver hardcodes
 * i2c_get_adapter(0), the address 0x2b, seven global GPIO numbers and seven
 * pinmux register writes. Every one of those is a board fact, and every one of
 * them lives here now.
 *
 * Polarity is declared, not coded. The two loopout enables are active low in
 * hardware and the two cable-detect inputs read 0 when a connector is mated;
 * saying so here is what lets the driver read as "1 means present".
 *
 * The interrupt line is EPHY_LED0, which the bootloader's pad table leaves
 * muxed to its EPHY function -- the vendor driver re-muxed it by hand at
 * runtime, which is measurable on the running board (the pad word reads
 * 0x00060083, not the 0x00000083 the boot table writes). Claiming the GPIO
 * does that properly. The pull-up is not ours to invent: it is in the boot
 * table already, and the vendor's own changelog records adding it for a board
 * revision whose interrupt line floated. It is spelled out below so the pad
 * keeps it whoever else touches the word.
 */
&i2c0 {
	status = "okay";

	hdmi-receiver@2b {
		compatible = "lontium,lt6911uxc";
		reg = <0x2b>;

		pinctrl-names = "default";
		pinctrl-0 = <&lt6911_int_pins>;

		interrupt-gpios = <&gpio1 28 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
		hdmi-power-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		loopout-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>,
				<&gpio2 17 GPIO_ACTIVE_LOW>;
		hdmi-rx-detect-gpios = <&gpio2 18 GPIO_ACTIVE_LOW>;
		hdmi-tx-detect-gpios = <&gpio2 19 GPIO_ACTIVE_LOW>;

		/*
		 * The bridge's MIPI output (#83). drivers/misc/lt6911-manage.c
		 * is not a V4L2 subdev -- the bridge needs no per-stream
		 * programming and its /proc interface is the ABI userspace
		 * reads -- so nothing binds to this endpoint. It exists
		 * because the receiver reads its lane map from the far side of
		 * it, and because a capture graph that stops at the SoC's own
		 * pin is a graph that does not say where the video comes from.
		 */
		port {
			lt6911_out: endpoint {
				remote-endpoint = <&csi2_in>;
				clock-lanes = <2>;
				data-lanes = <0 1 3 4>;
			};
		};
	};
};

&pinctrl {
	/*
	 * Electrical configuration only, no function property: the mux is
	 * programmed by the GPIO claim, and a state that named a function
	 * would fight it under strict mode.
	 */
	lt6911_int_pins: lt6911-int-pins {
		lt6911-int {
			pins = "EPHY_LED0";
			bias-pull-up;
			drive-strength = <3>;
			input-schmitt-disable;
		};
	};

	/*
	 * The RGMII bus and its management pair (#89 rung 2q).
	 *
	 * These fourteen pads were the last thing on the board that NOTHING in
	 * Linux programmed: no pinctrl group named them and no GPIO consumer
	 * claimed them, so the kernel simply inherited whatever the loader had
	 * left. The vendor-derived U-Boot has an ethernet driver and leaves
	 * every one of them at mux 0, drive-strength 15 (read back as
	 * 0x0000000F at 0x104f003c..0x104f0108 on the running board). Mainline
	 * U-Boot has no ethernet driver, leaves them alone, and MDC/MDIO
	 * therefore never reach the PHY: the bus scan finds nothing at any of
	 * the 32 addresses and stmmac reports
	 *
	 *   mdio_bus stmmac-0: MDIO device at address 1 is missing.
	 *
	 * A board that only works because a particular bootloader happened to
	 * program its pads is not ported. Naming them here is the same lesson
	 * as the SW_PWR trap, one bus over.
	 *
	 * EPHY_CLK, EPHY_RSTN, EPHY_LED0 and EPHY_LED1 are deliberately NOT in
	 * this group: they are GPIOs on this board and their mux is programmed
	 * by the GPIO claim.
	 */
	gmac_pins: gmac-pins {
		gmac-mdio {
			pins = "RGMII_MDCK", "RGMII_MDIO";
			function = "rgmii";
			drive-strength = <15>;
			bias-disable;
			input-schmitt-disable;
		};

		gmac-rgmii {
			pins = "RGMII_RXD0", "RGMII_RXD1", "RGMII_RXD2",
			       "RGMII_RXD3", "RGMII_RXDV", "RGMII_RXCLK",
			       "RGMII_TXD0", "RGMII_TXD1", "RGMII_TXD2",
			       "RGMII_TXD3", "RGMII_TXEN", "RGMII_TXCLK";
			function = "rgmii";
			drive-strength = <15>;
			bias-disable;
			input-schmitt-disable;
		};
	};
};
