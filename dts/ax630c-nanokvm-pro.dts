// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

/*
 * Sipeed NanoKVM-Pro (Axera AX630C) -- minimal mainline board DT (#74).
 *
 * Board facts only: memory size, the firmware carveouts, the console, and a
 * cmdline that satisfies the U-Boot contract. Peripherals arrive with their
 * drivers (see ax630c.dtsi).
 */

#include "ax630c.dtsi"

/ {
	model = "Sipeed NanoKVM-Pro";
	compatible = "sipeed,nanokvm-pro", AX630C_SOC_COMPAT;

	aliases {
		serial0 = &uart0;
		ethernet0 = &gmac;
	};

	chosen {
		stdout-path = "serial0:115200n8";

		/*
		 * U-Boot overwrites this from its `bootargs` env at `booti`
		 * (fdt_chosen), so the string here is a documented default, not
		 * the authority. Two traps it encodes (docs/mainline-port.md
		 * section 5):
		 *
		 *  - blkdevparts= IS U-Boot's partition table. U-Boot parses it
		 *    out of its own env; if the clause is missing it silently
		 *    resets the env to the vendor BOOTARGS_EMMC. Never ship a
		 *    cmdline without it.
		 *  - fdt_chosen needs free space in the blob or boot_prep_linux
		 *    calls hang(). pkgs/dtb-mainline.nix passes `dtc -p 4096`
		 *    so a longer env string always fits.
		 *
		 * No mem= clause: the memory node below is correct, unlike the
		 * vendor DT's, so the kernel does not need to be told twice.
		 * U-Boot appends its own mem= from the board-id ADC read; that
		 * is harmless and will be dropped when U-Boot moves (#26).
		 */
		bootargs = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x4880000 loglevel=8 root=/dev/mmcblk0p17 rootfstype=ext4 rw rootwait blkdevparts=mmcblk0:768K(spl),512K(ddrinit),256K(atf),256K(atf_b),1536K(uboot),1536K(uboot_b),1M(env),6M(logo),6M(logo_b),1M(optee),1M(optee_b),1M(dtb),1M(dtb_b),64M(kernel),64M(kernel_b),128M(boot),-(rootfs)";
	};

	/*
	 * 1 GiB. The vendor DT claims 3 GiB (0xC0000000) and relies on U-Boot's
	 * mem= to cut it down -- wrong for every NanoKVM-Pro variant. Board
	 * variants differ only in this node.
	 */
	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x40000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* TF-A 2.7. no-map: secondary CPU bring-up runs from here. */
		atf@40040000 {
			reg = <0x0 0x40040000 0x0 0x40000>;
			no-map;
		};

		/*
		 * OP-TEE 3.21, firewalled by the ATF. Nothing in our stack
		 * calls it (no TEEC_ or tee_ symbol in any component), but the region
		 * must stay reserved regardless -- the secure world is using
		 * it whether or not Linux talks to it.
		 */
		optee@44200000 {
			reg = <0x0 0x44200000 0x0 0x2000000>;
			no-map;
		};

		/*
		 * The vendor kernel's pstore zones. Kept reserved, and untouched,
		 * so that a mainline excursion on slot B does not destroy the
		 * crash history of the slot-A system that has to diagnose it.
		 * The vendor DT declares one ramoops region here, 0xf0000 long,
		 * whose zones only reach 0x480e0000 -- everything past that is
		 * reserved on both sides and used by neither, which is why the
		 * two regions below can live there.
		 */
		vendor-pstore@48000000 {
			reg = <0x0 0x48000000 0x0 0xe0000>;
			no-map;
		};

		/*
		 * Our ramoops, deliberately NOT at the head of the window: the
		 * vendor kernel's own ramoops zaps every zone it owns at its
		 * probe, about 1.5 s into the boot that would read ours. A log
		 * written at 0x48000000 is destroyed by the very kernel meant to
		 * recover it (measured 2026-09-06).
		 *
		 * More precisely, this 64 KiB sits inside the DATA area of the
		 * vendor ramoops' ftrace zone (0x480d0000-0x480f0000). Nothing
		 * writes that data unless pstore function tracing is switched
		 * on, and the zap at the vendor's probe rewrites only the
		 * zone's own 12-byte header at 0x480d0000. Confirmed on
		 * hardware: a full mainline boot log written here was still
		 * intact after the vendor kernel had booted and read it.
		 *
		 * mem-type 1 is uncached. On a board whose only reset is a
		 * watchdog or a raw chip reset, neither of which writes back
		 * dirty cache lines, a cacheable pstore zone is a log that
		 * evaporates in exactly the case it exists for.
		 *
		 * Both sizes are powers of two because ramoops rounds them down
		 * to one anyway -- 0x6000 would silently become 0x4000, and a
		 * DT that has to be simulated to know its own layout is worse
		 * than a DT that is simply explicit. 0x4000 console, and the
		 * 0x4000 remainder becomes two 0x2000 dump records.
		 *
		 * This is the only channel that survives when userspace never
		 * runs: the console zone holds the boot log from the first
		 * printk (pstore's console registers with CON_PRINTBUFFER, so
		 * the buffered log is replayed into it), and the dump zone holds
		 * the panic.
		 */
		ramoops@480e0000 {
			compatible = "ramoops";
			reg = <0x0 0x480e0000 0x0 0x8000>;
			console-size = <0x4000>;
			record-size = <0x2000>;
			mem-type = <1>;
		};

		/*
		 * The bring-up initramfs's kernel-log stash
		 * (pkgs/kernel-mainline/initramfs/bringup-init.c). Mapped, not
		 * no-map, and written through an O_SYNC /dev/mem mapping, which
		 * arm64 makes write-combining -- so it reaches DRAM without
		 * depending on a cache flush that no reset on this SoC performs.
		 *
		 * Read it back from the vendor system after the excursion:
		 *   dd if=/dev/mem bs=4096 skip=$((0x480e8000/4096)) count=8
		 * The first 32 bytes are a magic string and a u32 length at +24.
		 */
		bringup-log@480e8000 {
			reg = <0x0 0x480e8000 0x0 0x8000>;
		};
	};
};

/*
 * Ethernet (#77). A Realtek RTL8211F at MDIO address 1, RGMII.
 *
 * NOT a JLSemi JL2101, whatever the vendor DT says. That DT declares
 * `compatible = "ethernet-phy-id937c.4030"` on this node, which makes the MDIO
 * core skip the bus read entirely and bind the vendor's JLSemi driver to
 * whatever is actually there. Read over MDIO on the running board 2026-09-06,
 * the part answers PHYID1 = 0x001c, PHYID2 = 0xc916 -- Realtek's RTL8211F, and
 * mainline's own realtek driver claims it. So there is no JL2101 driver to
 * write; that half of #77's scope simply does not exist on this hardware.
 *
 * Hence no `compatible` on the PHY node here: the scan reads the real ID.
 *
 * phy-mode = "rgmii-id", and this is the whole ballgame. The RTL8211F's two
 * 2 ns delays come up ENABLED from pin-strapping (measured: page 0xd08 TXCR
 * bit 8 = 1, RXCR bit 3 = 1 on the running vendor system), and the vendor's
 * JLSemi driver never writes them -- its RGMII block is compiled out. Mainline's
 * realtek driver is not so passive: rtl8211f_config_rgmii_delay() writes both
 * bits to match phy-mode, so "rgmii" DISABLES the delays the board is built
 * around. That failure looks like success -- the link trains and reports
 * 1 Gbps/full -- and then no frame survives. It cost one boot cycle to find.
 *
 * The twenty `jl2xxx,*` tuning properties the vendor DT carries are inert even
 * on the driver they were written for (each is gated behind a compile-time
 * operation mode that is NONE or C_MACRO), and irrelevant here regardless.
 */
&gmac {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&phy1>;

	/*
	 * The PHY's RSTn, GPIO1_A27 (pad EPHY_RSTN, muxed to GPIO by the
	 * bootloader pad table). This is the GPIO block's per-line control
	 * word: gpio1 base 0x04801000 + (27 + 1) * 4.
	 *
	 * TODO(#81): delete this and put
	 *   reset-gpios = <&gpio1 27 GPIO_ACTIVE_LOW>;
	 *   reset-assert-us = <15000>;
	 *   reset-deassert-us = <75000>;
	 * on the PHY node instead, where the MDIO core handles it. There is no
	 * GPIO controller node to point at yet, and a mainline kernel that
	 * cannot release its PHY has no way to report that it could not.
	 */
	axera,phy-reset-mmio = <0x04801070>;

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		phy1: ethernet-phy@1 {
			reg = <1>;
		};
	};
};
