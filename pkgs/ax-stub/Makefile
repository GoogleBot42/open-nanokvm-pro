# Out-of-tree build of the ax_npu/ax_gdc/ax_ivps/ax_vpp symbol stub module (#56).
#
# -Wno-missing-prototypes / -Wno-missing-declarations: every stub is a bare
# exported symbol with no header, which is the entire point.
ccflags-y += -Wno-missing-prototypes -Wno-missing-declarations

obj-m += ax_stub.o
