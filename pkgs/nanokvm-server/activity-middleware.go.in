package middleware

// RecordActivity -- the "somebody is using the web UI" clock (#86).
//
// Registered globally in main.go, ahead of every router. It exists because
// CheckToken() is stateless: nothing in the server knows when a human last did
// anything, and an unattended update needs that to decide whether rebooting
// would interrupt someone.
//
// TWO THINGS ARE FILTERED OUT, and both would otherwise make the device
// permanently "busy":
//
//   * LOOPBACK. The mini-display daemon polls /api/streamer/local roughly once
//     a second from 127.0.0.1, and `nanokvm-update` polls the idle route the
//     same way. A clock those refresh can never run down.
//   * THE IDLE ROUTE ITSELF, from anywhere, for the same reason -- asking the
//     question must not change the answer.
//
// Everything else counts, including the initial GET of a websocket upgrade:
// that is a person opening the console, and the session itself is then counted
// by the client registries.
//
// Installed as middleware/activity.go by pkgs/nanokvm-server.nix.

import (
	"strings"

	"NanoKVM-Server/common"

	"github.com/gin-gonic/gin"
)

func RecordActivity() gin.HandlerFunc {
	return func(c *gin.Context) {
		ip := c.ClientIP()
		local := ip == "::1" || strings.HasPrefix(ip, "127.")
		probe := strings.HasPrefix(c.Request.URL.Path, "/api/update/idle") ||
			strings.HasPrefix(c.Request.URL.Path, "/api/application/pending")

		if !local && !probe {
			common.MarkAPIActivity()
		}

		c.Next()
	}
}
