new file mode 100644
index 00000000..227e51df
--- /dev/null
+++ b/arch/arm/mach-axera/Kconfig
@@ -0,0 +1,27 @@
+if ARCH_AXERA
+
+config SYS_SOC
+	default "ax630c"
+
+config SYS_VENDOR
+	default "axera"
+
+choice
+	prompt "Axera AX630C board"
+
+config TARGET_AX630C_NANOKVM_PRO
+	bool "Sipeed NanoKVM-Pro"
+	help
+	  Sipeed NanoKVM-Pro: an AX630C (2x Cortex-A53) IP-KVM with 1 GiB
+	  DRAM, an 8-bit eMMC, a Realtek RTL8211F gigabit PHY on RGMII and an
+	  LT6911UXC HDMI receiver.
+
+	  U-Boot runs as BL33. The boot ROM loads a signed first-stage loader
+	  which trains DRAM, locks the PLLs, sets every clock mux and hands
+	  control to TF-A, so this port programs no clocks of its own.
+
+endchoice
