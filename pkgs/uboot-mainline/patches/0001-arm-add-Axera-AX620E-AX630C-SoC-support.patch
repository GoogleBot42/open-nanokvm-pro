diff --git a/arch/arm/mach-axera/soc.c b/arch/arm/mach-axera/soc.c
new file mode 100644
index 00000000..01a401cf
--- /dev/null
+++ b/arch/arm/mach-axera/soc.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Axera AX620E family (AX630C) SoC support.
+ *
+ * Copyright (C) 2026 open-nanokvm-pro contributors
+ */
+
+#include <fdtdec.h>
+#include <init.h>
+#include <asm/armv8/mmu.h>
+#include <asm/global_data.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/*
+ * Everything below 1 GiB is MMIO on this SoC: the on-chip RAM the boot ROM
+ * runs from, the GIC at 0x01851000, three Cadence SD4HC instances, the syscon
+ * blocks that hold the clock gates and reset bits, and the UARTs at
+ * 0x04880000. DRAM starts at 0x40000000; the widest part in the family is
+ * 4 GiB and it is always one bank -- but dram_init() below shrinks the entry
+ * to the size the device tree declares, because a cacheable normal-memory
+ * mapping over addresses that no slave answers is an invitation to a
+ * speculative access that never completes.
+ */
+static struct mm_region ax620e_mem_map[] = {
+	{
+		.virt = 0x0UL,
+		.phys = 0x0UL,
+		.size = 0x40000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			 PTE_BLOCK_NON_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN
+	}, {
+		.virt = 0x40000000UL,
+		.phys = 0x40000000UL,
+		.size = 0x100000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) |
+			 PTE_BLOCK_INNER_SHARE
+	}, {
+		/* Terminator */
+		0,
+	}
+};
+
+struct mm_region *mem_map = ax620e_mem_map;
+
+int dram_init(void)
+{
+	int ret = fdtdec_setup_mem_size_base();
+
+	if (ret)
+		return ret;
+
+	/* Map only the DRAM that is really there. */
+	ax620e_mem_map[1].size = gd->ram_size;
+
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
diff --git a/include/configs/ax630c.h b/include/configs/ax630c.h
new file mode 100644
index 00000000..957d58c6
--- /dev/null
+++ b/include/configs/ax630c.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Axera AX630C boards.
+ *
+ * Copyright (C) 2026 open-nanokvm-pro contributors
+ */
+
+#ifndef __AX630C_H
+#define __AX630C_H
+
+#define CFG_SYS_SDRAM_BASE		0x40000000
+
+/*
+ * Load addresses. DRAM is 0x40000000..0x80000000 on this board and four
+ * regions inside it belong to somebody else, so the four load addresses below
+ * are chosen to miss all of them:
+ *
+ *   0x40000000 + 4 KiB   a DDR retrain engine the first-stage loader may arm
+ *   0x40040000 + 256 KiB TF-A BL31, resident
+ *   0x44200000 + 32 MiB  OP-TEE BL32, resident and firewalled
+ *   0x48000000 + 960 KiB the pstore/ramoops window Linux reads across a reset
+ *
+ * U-Boot itself is entered at 0x5C000400 and relocates to the top of DRAM, so
+ * everything below stays under 0x5C000000.
+ */
+#define CFG_EXTRA_ENV_SETTINGS						\
+	"fdtfile=" CONFIG_DEFAULT_DEVICE_TREE ".dtb\0"			\
+	"scriptaddr=0x49000000\0"					\
+	"pxefile_addr_r=0x49100000\0"					\
+	"fdt_addr_r=0x49200000\0"					\
+	"kernel_addr_r=0x4a000000\0"					\
+	"ramdisk_addr_r=0x4e000000\0"					\
+	"initrd_high=0xffffffffffffffff\0"				\
+	"fdt_high=0xffffffffffffffff\0"					\
+	"bootdev=0\0"							\
+	"bootpart=10\0"		/* HEX: dev:part is base 16, so p16 */	\
+	"extlinux_cfg=/extlinux/extlinux.conf\0"			\
+	"extlinux_fallback=/extlinux/extlinux-fallback.conf\0"		\
+	AX630C_MILESTONE_ENV
+
+/*
+ * `bootlimit` and `altbootcmd` are deliberately NOT here: env_default.h emits
+ * CONFIG_BOOTCOUNT_BOOTLIMIT and CONFIG_BOOTCOUNT_ALTBOOTCMD ahead of
+ * CFG_EXTRA_ENV_SETTINGS, and the first definition of a name wins, so a copy
+ * in this file would be dead text. They are set in the defconfig.
+ */
+
+/*
+ * Boot milestones, and the only observability this board has before Linux is
+ * up: the console UART is on hidden pads, so a bit in a register that survives
+ * a reset is what says how far the boot got.
+ *
+ * TOP_CHIPMODE_GLB_BACKUP0 (0x02390024) is a scratch register the boot ROM,
+ * the first-stage loader and TF-A all leave alone above bit 11. +0x4 is a
+ * write-1-to-set alias and +0x8 a write-1-to-clear alias, so a milestone is
+ * one `mw.l` and can never disturb the boot-slot bits below it. The register
+ * survives a warm reboot and a chip reset, and clears on power loss.
+ *
+ * Bits 12..27 belong to Linux -- the mainline bring-up initramfs and the
+ * appliance's own self-test between them own every one of those -- so the
+ * bootloader gets 28..31. The top two are named OTA_STATUS and OTA_SUPPORT in
+ * a single first-stage-loader header and read by nothing anywhere in the
+ * vendor tree: reserved names, not live flags.
+ */
+#define AX630C_MILESTONE_ENV						\
+	"msreg_set=0x02390028\0"					\
+	"ms_uboot=0x10000000\0"		/* 28: preboot reached */	\
+	"ms_extlinux=0x20000000\0"	/* 29: extlinux.conf read */	\
+	"ms_altboot=0x40000000\0"	/* 30: bootlimit hit */		\
+	"ms_failed=0x80000000\0"	/* 31: nothing booted */		\
+	AX630C_WDT_ENV
+
+/*
+ * Arm WDT0 before handing off, so a boot that hangs anywhere after `preboot`
+ * resets the board instead of stranding it. This SoC's console UART is on
+ * hidden pads; an unattended board that hangs is a board somebody has to walk
+ * to.
+ *
+ * NOT WIRED INTO `preboot` YET, and the reason is a measurement: running this
+ * from `preboot` with TORR = 0x80be reset the board about one second later,
+ * during the autoboot countdown. So TORR is not the raw `freq >> 16` down
+ * count this value assumed -- the vendor's own 0x2AEA yields 60 s, and 0x80be
+ * should have been longer, not shorter. The register needs characterising
+ * before U-Boot arms it; until then a boot that hangs strands the board, which
+ * is the lesser risk of the two.
+ *
+ * The sequence itself is the vendor bootloader's, which Linux is known to
+ * inherit cleanly: program the timeout, strobe TORR_LOAD, select the 24 MHz
+ * source, then enable. Linux's ax630c-wdt adopts a running WDT0 and the
+ * watchdog core pets it from then on.
+ *
+ * Written with `mw` so the port needs no watchdog driver to be safe. A real
+ * UCLASS_WDT driver replacing this is a separate change.
+ */
+#define AX630C_WDT_ENV							\
+	"wdt_arm=mw.l 0x0484000c 0x80be; mw.l 0x04840018 1;"		\
+		" mw.l 0x04840018 0; mw.l 0x048700a8 0x80000;"		\
+		" mw.l 0x04840000 1\0"
+
+#endif /* __AX630C_H */
