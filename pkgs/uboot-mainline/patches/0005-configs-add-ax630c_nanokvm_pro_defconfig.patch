From 8c5b763e2d04a8a8bc908ac20f9070c0902dd03c Mon Sep 17 00:00:00 2001
From: "Claude Fable 5.1" <noreply@anthropic.com>
Date: Mon, 7 Sep 2026 22:36:43 -0600
Subject: [PATCH 5/5] configs: add ax630c_nanokvm_pro_defconfig

Standard boot from an extlinux.conf on the eMMC, with the layout coming from
the blkdevparts= clause the kernel also reads, the environment in the eMMC
partition the vendor boot chain already reserves for it, and bootcount /
bootlimit / altbootcmd for a health-gated fallback to the previous
generation.

Two entries are board-specific and load-bearing. The pre-console buffer is
banked in a reserved DRAM window that survives a reset, because this board's
console UART is on hidden pads and a register that outlives a hang is the
only evidence a failed boot can leave. And `preboot` and `bootcmd` set bits
25..29 of the SoC's boot scratch register as they go, so Linux can read back
how far the bootloader got.

Signed-off-by: open-nanokvm-pro contributors <nanokvm@localhost>
---
 configs/ax630c_nanokvm_pro_defconfig | 44 ++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)
 create mode 100644 configs/ax630c_nanokvm_pro_defconfig

diff --git a/configs/ax630c_nanokvm_pro_defconfig b/configs/ax630c_nanokvm_pro_defconfig
new file mode 100644
index 00000000..888311d9
--- /dev/null
+++ b/configs/ax630c_nanokvm_pro_defconfig
@@ -0,0 +1,44 @@
+CONFIG_ARM=y
+CONFIG_COUNTER_FREQUENCY=24000000
+CONFIG_ARCH_AXERA=y
+CONFIG_TEXT_BASE=0x5C000400
+CONFIG_SYS_MALLOC_LEN=0x800000
+CONFIG_NR_DRAM_BANKS=1
+CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
+CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x5BF00000
+CONFIG_ENV_SIZE=0x100000
+CONFIG_ENV_OFFSET=0x4C0000
+CONFIG_DEFAULT_DEVICE_TREE="ax630c-nanokvm-pro"
+CONFIG_SYS_LOAD_ADDR=0x4a000000
+CONFIG_PRE_CON_BUF_ADDR=0x480e8000
+CONFIG_PRE_CON_BUF_SZ=8192
+CONFIG_IDENT_STRING=" nanokvm-pro"
+# CONFIG_EFI_LOADER is not set
+CONFIG_BOOTSTD_DEFAULTS=y
+CONFIG_BOOTDELAY=1
+CONFIG_BOOTCOMMAND="if load mmc ${bootdev}:${bootpart} ${scriptaddr} ${extlinux_cfg}; then mw.l ${msreg_set} ${ms_extlinux}; sysboot mmc ${bootdev}:${bootpart} any ${scriptaddr} ${extlinux_cfg}; fi; mw.l ${msreg_set} ${ms_failed}; reset"
+CONFIG_USE_PREBOOT=y
+CONFIG_PREBOOT="mw.l ${msreg_set} ${ms_uboot}"
+CONFIG_SYS_PBSIZE=1074
+CONFIG_PRE_CONSOLE_BUFFER=y
+# CONFIG_DISPLAY_CPUINFO is not set
+CONFIG_SYS_PROMPT="ax630c# "
+CONFIG_CMD_MMC=y
+CONFIG_CMD_SYSBOOT=y
+# CONFIG_DOS_PARTITION is not set
+# CONFIG_ISO_PARTITION is not set
+CONFIG_CMDLINE_PARTITION=y
+CONFIG_CMDLINE_PARTITION_DEFAULT="blkdevparts=mmcblk0:768K(spl),512K(ddrinit),256K(atf),256K(atf_b),1536K(uboot),1536K(uboot_b),1M(env),6M(logo),6M(logo_b),1M(optee),1M(optee_b),1M(dtb),1M(dtb_b),64M(kernel),64M(kernel_b),128M(boot),-(rootfs)"
+# CONFIG_EFI_PARTITION is not set
+CONFIG_ENV_IS_IN_MMC=y
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_ENV=y
+CONFIG_BOOTCOUNT_BOOTLIMIT=3
+CONFIG_BOOTCOUNT_ALTBOOTCMD="mw.l ${msreg_set} ${ms_altboot}; sysboot mmc ${bootdev}:${bootpart} any ${scriptaddr} ${extlinux_fallback}; reset"
+CONFIG_MMC_HS200_SUPPORT=y
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_ADMA=y
+CONFIG_MMC_SDHCI_CADENCE=y
+CONFIG_SYS_NS16550=y
+CONFIG_SYSRESET=y
+CONFIG_SYSRESET_SYSCON=y
