diff -urN a/src/pages/desktop/screen/h265-direct.tsx b/src/pages/desktop/screen/h265-direct.tsx
--- a/src/pages/desktop/screen/h265-direct.tsx	1969-12-31 17:00:00.000000000 -0700
+++ b/src/pages/desktop/screen/h265-direct.tsx	2026-09-05 10:40:00.468361466 -0600
@@ -0,0 +1,55 @@
+import { useEffect, useState } from 'react';
+import { notification } from 'antd';
+import { useTranslation } from 'react-i18next';
+
+import * as api from '@/api/stream.ts';
+import * as storage from '@/lib/localstorage.ts';
+import { probeH265DirectSupport } from '@/lib/video.ts';
+
+import { DirectPlayer, H264Direct } from './h264-direct.tsx';
+
+// H.265 Direct: the H.264 Direct player pointed at /api/stream/h265/direct
+// with the worker's hvc1 decoder config. The browser is asked first
+// (VideoDecoder.isConfigSupported); one that cannot decode HEVC -- Firefox,
+// some Linux Chrome builds -- gets H.264 Direct instead, a notice saying so,
+// and the stored mode is rewritten so the next load starts on H.264.
+export const H265Direct = () => {
+  const { t } = useTranslation();
+  const [notify, contextHolder] = notification.useNotification();
+  const [supported, setSupported] = useState<boolean | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    probeH265DirectSupport().then((ok) => {
+      if (cancelled) return;
+
+      if (!ok) {
+        storage.setVideoMode('h264-direct');
+        api.setMode('h264-direct');
+
+        notify.warning({
+          key: 'h265_fallback',
+          message: t('notification.h265.notSupported'),
+          description: t('notification.h265.fallback'),
+          placement: 'topRight',
+          duration: 10
+        });
+      }
+
+      setSupported(ok);
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  return (
+    <>
+      {contextHolder}
+      {supported === true && <DirectPlayer init="init_h265" connect={api.directH265} />}
+      {supported === false && <H264Direct />}
+    </>
+  );
+};
