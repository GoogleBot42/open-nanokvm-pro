+// H.265 over the direct (WebSocket + WebCodecs) path. Main profile, Main tier,
+// level 5.1 -- the level the device's encoder writes for 4K; the decoder is
+// configured without a description (Annex-B, parameter sets in-band on every
+// key frame), for which the level is advisory, so one probe covers every
+// geometry the device ships.
+export const H265_DIRECT_CODEC = 'hvc1.1.6.L153.B0';
+
+let h265DirectSupported: boolean | null = null; // null = probe still pending
+let h265DirectProbe: Promise<boolean> | null = null;
+
+export function probeH265DirectSupport(): Promise<boolean> {
+  if (h265DirectProbe) return h265DirectProbe;
+
+  h265DirectProbe = (async () => {
+    if (!isDecoderSupported()) return false;
+
+    try {
+      const { supported } = await VideoDecoder.isConfigSupported({
+        codec: H265_DIRECT_CODEC,
+        optimizeForLatency: true
+      });
+      return !!supported;
+    } catch {
+      return false;
+    }
+  })().then((ok) => {
+    h265DirectSupported = ok;
+    return ok;
+  });
+
+  return h265DirectProbe;
+}
+
+// Synchronous view for the mode lists. Optimistic while the probe (started at
+// module load, resolves in milliseconds) is pending, so a stored h265-direct
+// survives the Desktop mount check; the H265Direct screen re-checks and falls
+// back to h264-direct with a notice when the browser cannot decode HEVC.
+export function isH265DirectSupported() {
+  return isDecoderSupported() && h265DirectSupported !== false;
+}
+
+if (typeof window !== 'undefined') {
+  void probeH265DirectSupport();
+}
