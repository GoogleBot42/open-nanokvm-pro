diff -Naur tfa-orig/plat/axera/ax630c/include/platform_def.h tfa/plat/axera/ax630c/include/platform_def.h
--- a/plat/axera/ax630c/include/platform_def.h	1969-12-31 17:00:00.000000000 -0700
+++ b/plat/axera/ax630c/include/platform_def.h	2026-09-07 22:07:44.950069634 -0600
@@ -0,0 +1,78 @@
+/*
+ * Copyright (c) 2026, Axera AX630C platform contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef PLATFORM_DEF_H
+#define PLATFORM_DEF_H
+
+#include <arch.h>
+#include <plat/common/common_def.h>
+
+#include <ax630c_def.h>
+
+/*******************************************************************************
+ * Platform binary types for linking
+ ******************************************************************************/
+#define PLATFORM_LINKER_FORMAT		"elf64-littleaarch64"
+#define PLATFORM_LINKER_ARCH		aarch64
+
+/*******************************************************************************
+ * Generic platform constants
+ ******************************************************************************/
+#define PLATFORM_STACK_SIZE		UL(0x800)
+
+/* The generic timer is fed from the 24 MHz crystal. */
+#define SYS_COUNTER_FREQ		U(24000000)
+
+/* One cluster of two Cortex-A53s. */
+#define PLATFORM_CLUSTER_COUNT		U(1)
+#define PLATFORM_CORE_COUNT		U(2)
+#define PLATFORM_MAX_CPUS_PER_CLUSTER	U(2)
+
+/*
+ * BL31 implements CPU_ON/CPU_OFF and SYSTEM_RESET only. There is no cluster
+ * or system power-down path, so the deepest power domain the platform
+ * describes is the cluster.
+ */
+#define PLAT_MAX_PWR_LVL		MPIDR_AFFLVL1
+#define PLAT_MAX_RET_STATE		U(1)
+#define PLAT_MAX_OFF_STATE		U(2)
+
+#define PLAT_LOCAL_STATE_RUN		U(0)
+#define PLAT_LOCAL_STATE_RET		U(1)
+#define PLAT_LOCAL_STATE_OFF		U(2)
+
+/*
+ * Cookie the loader passes in x3. It is the stock TF-A value and is only
+ * checked by a debug build.
+ */
+#define ARM_BL31_PLAT_PARAM_VAL		ULL(0x0f1e2d3c4b5a6978)
+
+/*******************************************************************************
+ * BL31 specific defines.
+ *
+ * The first-stage loader stages the 1 KiB image header at 0x4003FC00 and
+ * enters the payload immediately after it, at a fixed 0x40040000. The `atf`
+ * flash partition, and hence the DRAM window BL31 owns, is 256 KiB.
+ ******************************************************************************/
+#define BL31_BASE			UL(0x40040000)
+#define BL31_SIZE			UL(0x00040000)
+#define BL31_LIMIT			(BL31_BASE + BL31_SIZE)
+
+/*******************************************************************************
+ * Platform specific page table and MMU setup constants
+ ******************************************************************************/
+#define PLAT_PHY_ADDR_SPACE_SIZE	(ULL(1) << 32)
+#define PLAT_VIRT_ADDR_SPACE_SIZE	(ULL(1) << 32)
+#define MAX_XLAT_TABLES			U(6)
+#define MAX_MMAP_REGIONS		U(8)
+
+/*******************************************************************************
+ * Cache line size, used to align the PSCI mailboxes.
+ ******************************************************************************/
+#define CACHE_WRITEBACK_SHIFT		U(6)
+#define CACHE_WRITEBACK_GRANULE		(U(1) << CACHE_WRITEBACK_SHIFT)
+
+#endif /* PLATFORM_DEF_H */
diff -Naur tfa-orig/plat/axera/ax630c/platform.mk tfa/plat/axera/ax630c/platform.mk
--- a/plat/axera/ax630c/platform.mk	1969-12-31 17:00:00.000000000 -0700
+++ b/plat/axera/ax630c/platform.mk	2026-09-07 22:14:07.379410689 -0600
@@ -0,0 +1,48 @@
+#
+# Copyright (c) 2026, Axera AX630C platform contributors. All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+
+include drivers/arm/gic/v2/gicv2.mk
+include lib/xlat_tables_v2/xlat_tables.mk
+
+AX630C_PLAT		:=	plat/axera/ax630c
+
+PLAT_INCLUDES		:=	-I${AX630C_PLAT}/include
+
+BL31_SOURCES		+=	${GICV2_SOURCES}				\
+				${XLAT_TABLES_LIB_SRCS}				\
+				drivers/delay_timer/delay_timer.c		\
+				drivers/delay_timer/generic_delay_timer.c	\
+				drivers/ti/uart/aarch64/16550_console.S		\
+				lib/cpus/aarch64/cortex_a53.S			\
+				plat/common/plat_gicv2.c			\
+				plat/common/plat_psci_common.c			\
+				${AX630C_PLAT}/aarch64/ax630c_helpers.S		\
+				${AX630C_PLAT}/ax630c_bl31_setup.c		\
+				${AX630C_PLAT}/ax630c_gicv2.c			\
+				${AX630C_PLAT}/ax630c_pm.c			\
+				${AX630C_PLAT}/ax630c_topology.c
+
+# BL31 is loaded from flash by a vendor first-stage loader and entered with a
+# bl_params_t v2 chain, so it is an ordinary loaded BL31, not a reset vector.
+RESET_TO_BL31		:=	0
+
+# Two Cortex-A53s, released one at a time through the CPU mailbox: the
+# secondary is still in the boot ROM's WFE loop when BL31 starts.
+COLD_BOOT_SINGLE_CPU	:=	1
+
+# Cortex-A53 r0p4 and earlier; applies to every revision, so always on.
+ERRATA_A53_1530924	:=	1
+
+# No cluster-level coherency management and no SVE in the normal world.
+HW_ASSISTED_COHERENCY	:=	0
+USE_COHERENT_MEM	:=	0
+ENABLE_SVE_FOR_NS	:=	0
+
+# BL33 is a Linux-style payload: x0 carries the device tree address (zero on
+# this SoC, so BL33 must be self-contained) and x1-x3 are zero.
+ARM_LINUX_KERNEL_AS_BL33	:=	1
+$(eval $(call assert_boolean,ARM_LINUX_KERNEL_AS_BL33))
+$(eval $(call add_define,ARM_LINUX_KERNEL_AS_BL33))
