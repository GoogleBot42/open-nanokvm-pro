# ---------------------------------------------------------------------------
# AX630C / NanoKVM-Pro config fragment, merged over arm64 `defconfig` (#74).
#
# Deliberately small. arm64 defconfig already carries the SoC-core drivers this
# board needs (GICv2, PSCI, arch timer, 8250_dw, sdhci-cadence, stmmac, dwc3),
# so this fragment only pins the things a bring-up must not lose and the things
# the vendor 4.19 defconfig got wrong. Per-subsystem enablement arrives with the
# child issues that port each driver (#75 watchdog, #76 storage, #77 net, ...).
# ---------------------------------------------------------------------------

# --- Identity -------------------------------------------------------------
# A fixed, build-reproducible release string. LOCALVERSION_AUTO would splice in
# a git description of the KERNEL tree (absent here) and make the string vary.
CONFIG_LOCALVERSION="-nanokvm"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Boot path ------------------------------------------------------------
# U-Boot's `booti` passes an Image plus our dtb and no initramfs; NixOS supplies
# an initrd later (#78). Keep initrd support compiled in either way.
CONFIG_BLK_DEV_INITRD=y
# Trap 1 (docs/mainline-port.md section 5): U-Boot's partition table IS the
# `blkdevparts=` clause in the cmdline. The eMMC carries NO on-disk partition
# table -- without this the card enumerates as a bare mmcblk0 with no
# partitions at all, which is exactly what the first #76 boot did.
#
# The symbol is CMDLINE_PARTITION. It is NOT "BLK_CMDLINE_PARSER" -- that name
# died with 4.19, and setting it here did nothing for two issues because a
# nonexistent symbol is dropped by olddefconfig in silence. Its prompt is
# `if PARTITION_ADVANCED`, so that has to be on as well or this stays n
# whatever the fragment says.
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
# THE eMMC IS TWO LOGICAL DEVICES (#89 rung 4). `blkdevparts=` splits the raw
# card into `spl` (the 768 KiB the BootROM reads) and `disk` (the rest); `disk`
# then carries a real GPT at its own LBA 0, which the kernel scans once stage 1
# has put a loop device over it. Both parsers are therefore load-bearing, and
# so is the loop driver -- without EFI_PARTITION the loop device would come up
# with no partitions at all and there would be no root to mount.
CONFIG_EFI_PARTITION=y

# --- Debug/serial ---------------------------------------------------------
# The board's UART0 is on hidden pads (docs: "No serial on this unit"), so the
# console is a last resort -- but earlycon is the only thing that would ever
# explain an early hang, so it stays built in.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Watchdog (#75) -------------------------------------------------------
# U-Boot arms wdt0 for 30 s immediately before `booti`, and the ATF implements
# no PSCI system_reset -- so the watchdog is both the thing that must be petted
# and the only way to reboot. The axera,ax-wdt driver itself is #75; this is the
# core support it plugs into.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y

# --- Resets (#80) ---------------------------------------------------------
# The reset lines live in the clock controllers' own syscon windows and are
# handed out by the same driver (which selects this symbol). Pinned because the
# watchdog -- the thing that keeps this board from resetting mid-boot -- takes
# two reset handles, and reset_control_get on a kernel without the core returns
# an error rather than a no-op.
CONFIG_RESET_CONTROLLER=y

# --- Clocks (#80) ---------------------------------------------------------
# The SoC's eight clock controllers, 268 clocks and 150 reset lines. Built in,
# not modular: the
# storage and serial drivers clk_get() from these long before there is a
# rootfs to load a module from. MFD_SYSCON comes with it (the windows are
# shared with the reset controller, so the driver takes the syscon regmap).
CONFIG_COMMON_CLK_AX630C=y

# --- Pin control (#80) ----------------------------------------------------
# 111 pads. Also the fix for the SW_PWR pinmux trap: with a real pinctrl/GPIO
# pair, claiming a GPIO line programs its mux, which sysfs export never did.
CONFIG_PINCTRL_AX630C=y

# --- GPIO (#81) -----------------------------------------------------------
# Four 32-line controllers. The other half of the SW_PWR fix: a GPIO request
# reaches the pin controller's gpio_request_enable() only if there is a driver
# to make the request. GPIOLIB and OF_GPIO come from arm64 defconfig; they are
# pinned because the ATX lines, the HDMI receiver rails and the PHY reset all
# hang off them.
CONFIG_GPIOLIB=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_AX630C=y
# The knob, the encoder and the LT6911 interrupt are GPIO IRQ consumers.
CONFIG_GPIOLIB_IRQCHIP=y

# --- I2C (#81) ------------------------------------------------------------
# i2c0 carries the LT6911UXC HDMI receiver. Stock Synopsys DesignWare, driven
# by mainline's own i2c-designware-platform; built in because the receiver's
# power-on sequence has to run before anything can capture.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y

# --- HDMI receiver (#81) --------------------------------------------------
# The LT6911UXC bridge's management driver: power sequencing, cable presence,
# and the /proc interface libkvm reads for the source's geometry. Built in for
# the same reason the GPIO driver is -- the bridge has to be powered before
# anything can capture from it.
CONFIG_LT6911_MANAGE=y

# --- Storage (#76) --------------------------------------------------------
# arm64 defconfig already sets all of these, which is exactly why they are
# pinned here: this is the rootfs path, and a silent defconfig change that
# turned one of them modular would produce a kernel that boots to "VFS: unable
# to mount root fs" with no console to say why. Built in, never modular.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_CADENCE=y
CONFIG_EXT4_FS=y
# The kernel's own partition scanner. blkdevparts= (trap 1) supplies the eMMC
# layout, but the SD card carries a real MBR and needs this to read it.
CONFIG_MSDOS_PARTITION=y

# --- Network (#77) --------------------------------------------------------
# arm64 defconfig builds stmmac as a module. There is no module path on this
# board yet -- the bring-up initramfs is a cpio with no .ko in it -- and this
# is the interface the system is reached over, so all of it is built in.
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_AXERA=y
# The board's PHY is a Realtek RTL8211F (PHYID 0x001cc916, read over MDIO
# 2026-09-06) -- NOT the JLSemi JL2101 the vendor DT forces with a fake
# ethernet-phy-id. arm64 defconfig already builds the realtek driver in, and it
# is the right one; no JLSemi driver is needed on this hardware.
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- USB gadget (#82) -----------------------------------------------------
# The appliance's whole reason to exist: the board is a USB peripheral that
# presents a keyboard, a mouse and a disk to the machine it controls. arm64
# defconfig already builds the DWC3 core and the gadget core in, but it builds
# the configfs gadget as a MODULE and carries neither the HID nor the UAC2
# function -- so all three are pinned here. Built in, never modular: the
# bring-up initramfs is a cpio with no .ko in it, and #78's rootfs comes later.
CONFIG_USB=y
CONFIG_USB_DWC3=y
# Dual role, not gadget-only. dr_mode is "peripheral" today (dts/ax630c.dtsi)
# because OTG ID detection needs a GPIO controller (#81); keeping the host half
# compiled means that arrives as a DT change rather than a kernel rebuild.
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_AXERA=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
# The five functions /kvmapp/scripts/usbdev.sh builds under
# /sys/kernel/config/usb_gadget/g0 (docs/nixos-rootfs.md, known gap 2): three
# HID interfaces (8-byte keyboard, 4-byte relative mouse, 6-byte absolute
# mouse), NCM, mass storage, UAC2 and ACM. Every one of them is gated at
# runtime by a flag file on the vfat /boot, so a missing symbol here does not
# fail loudly -- it just makes a feature quietly unavailable.
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_F_UAC2=y
# USB_CONFIGFS_F_UAC2 is a bool that `depends on SND` and selects SND_PCM.
# arm64 defconfig has SOUND and SND modular, which cannot satisfy a built-in
# gadget function, so both are pinned built-in here. This is the ONLY reason
# the sound core is compiled in at all right now; the board's real audio path
# (the LT6911 I2S capture card) is #84.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
# configfs itself. Already y in arm64 defconfig, pinned because the gadget is
# unreachable without it and the failure is a mount that returns ENODEV.
CONFIG_CONFIGFS_FS=y

# --- Interactive userspace in the initramfs (#77) -------------------------
# The bring-up initramfs now carries busybox and dropbear, so that "Ethernet
# works" can be demonstrated the only way that really counts: a shell.
# devtmpfs because dropbear needs the pty nodes and /dev/urandom, and an
# initramfs gets no automatic devtmpfs mount.
CONFIG_DEVTMPFS=y
CONFIG_UNIX98_PTYS=y

# --- Crash forensics ------------------------------------------------------
# No serial means a panic is otherwise invisible. ramoops over the vendor's
# reserved region is how a mainline oops gets read back after reboot.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y

# --- DMA ------------------------------------------------------------------
# CMA is ALLOWED here, unlike on the vendor 4.19 kernel. #49's "CMA is an ABI
# break" verdict was about struct layouts shared with prebuilt ax_*.ko; a
# mainline kernel loads none of those (#55/#54), so the constraint is gone.
CONFIG_CMA=y
CONFIG_DMA_CMA=y

# --- systemd / NixOS floor (#78) ------------------------------------------
# Recorded because the vendor defconfig lacks all of it ("# CONFIG_NAMESPACES
# is not set", no cgroup controllers, no TMPFS_XATTR/OVERLAY_FS) and nobody
# should copy that config forward. Every one of these is a unit that fails at
# runtime rather than a build error, on a board with no console.
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
# The 4.19 kernel's missing user namespaces are why PrivateUsers=true died with
# 217/USER and why pkgs.buildFHSEnv could not work at all (docs/nixos-rootfs.md
# "What that config costs at runtime"). Both constraints lift here.
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
# systemd's path units and RestrictFileSystems= machinery.
CONFIG_FANOTIFY=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- The appliance's own filesystems (#78) --------------------------------
# /boot is p16, vfat, and must be WRITABLE: NanoKVM-Server keeps its USB-gadget
# feature flags there (usb.ncm, usb.disk0, usb.uac2, eth.nodhcp) and the module
# loader sources /boot/configs. The two NLS tables are what mounting a FAT
# filesystem actually needs; without them the mount fails with -EINVAL.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# The reversible hardware-test root: a rootfs IMAGE FILE dropped onto the
# vendor rootfs and loop-mounted by stage 1, so a NixOS root can be booted
# without overwriting the partition that carries the only way back onto the
# board. See nixos/appliance.nix `nanokvm.rootImage`.
CONFIG_BLK_DEV_LOOP=y
# Since #89 rung 4 the loop driver is on the ROOT path, not just the test one:
# /dev/loop0 over `disk` is what makes the GPT visible. Pin the pre-created
# count so /dev/loop0 exists without anyone having to create it, because the
# root device is a compile-time constant in the initrd's fsinfo.
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# --- Build size -----------------------------------------------------------
# Nothing here consumes DWARF or BTF: no in-tree module signing, no bpf tooling
# on the appliance. Dropping both roughly halves the build.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_GCC_PLUGINS is not set

# --- Watchdog driver (#75) ------------------------------------------------
# Built in, and load-bearing: U-Boot arms wdt0 for 30 s immediately before
# `booti`, so a kernel without this driver is hard-reset a minute into every
# boot, indistinguishable from an early hang on a board with no console.
CONFIG_AX630C_WATCHDOG=y
# The core's kernel-side petting of a watchdog the bootloader already started.
# It defaults y, but this board does not boot without it, so pin it.
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# 0 = pet forever until userspace opens /dev/watchdog. A non-zero value here
# would reset the board that many seconds after the driver registers, which is
# exactly the failure a bring-up must not have to diagnose.
CONFIG_WATCHDOG_OPEN_TIMEOUT=0

# --- Reboot (#75) ---------------------------------------------------------
# PSCI on this TF-A implements no SYSTEM_RESET. syscon-reboot drives
# CHIP_RST_SW in the common syscon instead (dts/ax630c.dtsi "reboot"), which is
# what the vendor U-Boot's own reboot uses -- hardware-verified 2026-09-06.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
# A panic must not sit there forever on a board nobody can see. 5 s later
# emergency_restart() runs the same restart chain, after the pstore dump.
CONFIG_PANIC_TIMEOUT=5

# --- Crash forensics, continued (#75) -------------------------------------
# Without this ramoops records only oops/panic dumps. With it the whole kernel
# console lands in the persistent console zone -- and pstore's console
# registers with CON_PRINTBUFFER, so the log already buffered before ramoops
# probed is replayed into it. On a board with no serial that is the only way a
# failed boot is ever explained.
CONFIG_PSTORE_CONSOLE=y

# --- /dev/mem (#75, policy settled in #78) --------------------------------
# The bring-up init has no drivers to work through: it reaches the A/B slot
# register, the heartbeat LED and its log stash by mmap()ing /dev/mem. arm64's
# STRICT_DEVMEM would still allow the two MMIO windows, but not the stash,
# which is reserved-but-mapped System RAM.
#
# The appliance keeps it, deliberately, and this is that decision:
#   * the per-device identity service reads the SoC UID out of the misc_info
#     structure the bootloader leaves in IRAM0 at physical 0x740 -- a page that
#     is not System RAM, so mmap() on /dev/mem is the only way to reach it and
#     `devmem` is the only tool that does it (read(2) on /dev/mem goes through
#     xlate_dev_mem_ptr, which is a linear-map translation and meaningless for
#     a non-RAM page);
#   * nanokvm-checkboot re-arms the A/B slot register the same way the vendor's
#     S99checkboot does;
#   * the whole vendor script layer, and every debugging session this project
#     has ever had on this board, reaches hardware through it.
# It costs nothing on an appliance whose only account is root.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set

# --- Embedded initramfs (#75, #78) ----------------------------------------
# CONFIG_INITRAMFS_SOURCE and the INITRAMFS_COMPRESSION_* choice are both set
# from the Nix build (pkgs/kernel-mainline.nix), before this fragment is
# merged, because the choice `depends on INITRAMFS_SOURCE != ""`. They are NOT
# pinned here: the bring-up variant embeds a 100 KB cpio uncompressed (byte for
# byte, reproducible) while the appliance variant embeds a NixOS stage-1 initrd
# of tens of megabytes and must let the kernel zstd it. The build asserts
# whichever one it asked for actually survived olddefconfig.
