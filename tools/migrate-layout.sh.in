#!/usr/bin/env bash
# ===========================================================================
# In-place eMMC layout migration, run FROM the running appliance (#89 rung 4).
#
# Turns the vendor's 17-partition A/B map into the six-partition minimal one
# WITHOUT moving the root filesystem: both layouts put `rootfs` at the same
# byte, so everything this script writes lands inside the span the old p1-p16
# occupied and the filesystem it is running from is never touched.
#
# Every number below is substituted from nixos/lib/emmc-layout.nix by
# pkgs/migrate-layout.nix. Do not edit them here.
#
# THE ONE-WAY STEP IS `spl`, AND IT IS LAST. Until p1 is written the board's
# first-stage loader is still the vendor SPL, which reads BL31 and U-Boot from
# the OLD offsets -- and the `write` phase has overwritten those. So between
# `write` and `spl` the board cannot boot, and the only ways out are `spl`
# (forward) or `restore` (back). Do not power-cycle in that window. After p1
# is written the only way back is AXDL.
#
#   migrate-layout backup    save the whole pre-migration span + /boot + env
#   migrate-layout write     atf, uboot, env, boot at their NEW offsets
#   migrate-layout spl       write p1  (requires --i-have-the-go)
#   migrate-layout restore   put the saved span back, byte for byte
#   migrate-layout status    what is on the medium right now
#   migrate-layout flags     after the reboot: copy the server's runtime flag
#                            files back into the fresh /boot
# ===========================================================================
set -euo pipefail

DEV=/dev/mmcblk0
WORK=${MIGRATE_WORK:-/root/rung4}
IMAGES=${MIGRATE_IMAGES:-}

# ---- the layout, substituted from nixos/lib/emmc-layout.nix ---------------
SPL_OFF=@SPL_OFF@;     SPL_SIZE=@SPL_SIZE@
ATF_OFF=@ATF_OFF@;     ATF_SIZE=@ATF_SIZE@
UBOOT_OFF=@UBOOT_OFF@; UBOOT_SIZE=@UBOOT_SIZE@
ENV_OFF=@ENV_OFF@;     ENV_SIZE=@ENV_SIZE@
BOOT_OFF=@BOOT_OFF@;   BOOT_SIZE=@BOOT_SIZE@
ROOT_OFF=@ROOT_OFF@
NEW_ROOT_DEV=@NEW_ROOT_DEV@
OLD_ROOT_DEV=@OLD_ROOT_DEV@
CLAUSE="@CLAUSE@"
FW_ENV="@FW_ENV@"

say() { printf '%s\n' "$*"; }
die() { printf 'migrate-layout: %s\n' "$*" >&2; exit 1; }

# The appliance's PATH, not a Nix closure: this script is copied to an aarch64
# board and a substituted x86-64 store path would be useless there. Anything
# optional is guarded.
have() { command -v "$1" >/dev/null 2>&1; }
boot_mounted() { grep -q ' /boot ' /proc/mounts; }

drop_caches() { sync; echo 3 > /proc/sys/vm/drop_caches; }

# sha256 of a byte range read back FROM THE MEDIUM (never the page cache).
hash_span() { # off len
  dd if="$DEV" bs=4096 skip=$(( $1 / 4096 )) count=$(( $2 / 4096 )) \
     status=none iflag=fullblock | sha256sum | cut -d' ' -f1
}

hash_file() { sha256sum "$1" | cut -d' ' -f1; }

# Refuse any write that could reach the root filesystem or run off a boundary.
check_span() { # name off len
  local n=$1 off=$2 len=$3
  [ $(( off % 512 )) -eq 0 ] || die "$n: offset $off is not sector-aligned"
  [ $(( off + len )) -le "$ROOT_OFF" ] \
    || die "$n: $off+$len ends at $(( off + len )), past the rootfs start $ROOT_OFF"
}

# The invariant the whole migration rests on: root must still begin where both
# layouts say it does.
check_root_start() {
  local want=$(( ROOT_OFF / 512 )) got
  for p in "${OLD_ROOT_DEV##*/}" "${NEW_ROOT_DEV##*/}"; do
    if [ -r "/sys/class/block/$p/start" ]; then
      got=$(cat "/sys/class/block/$p/start")
      [ "$got" = "$want" ] \
        || die "$p starts at sector $got, expected $want -- WRONG BOARD OR WRONG LAYOUT"
      say "  root partition $p starts at sector $got (0x$(printf %X "$ROOT_OFF")) -- as expected"
      return 0
    fi
  done
  die "neither $OLD_ROOT_DEV nor $NEW_ROOT_DEV exists; refusing to touch $DEV"
}

need_images() {
  [ -n "$IMAGES" ] || IMAGES=$(dirname "$0")/../images
  for f in atf.bin uboot.bin env.bin bootfs.ext4.gz spl.bin; do
    [ -r "$IMAGES/$f" ] || die "missing image $IMAGES/$f (set MIGRATE_IMAGES)"
  done
  say "images: $IMAGES"
}

# ---------------------------------------------------------------- backup ---
cmd_backup() {
  check_root_start
  mkdir -p "$WORK"

  say "== recording the pre-migration state"
  {
    date -Is
    echo "--- /proc/cmdline";      cat /proc/cmdline
    echo "--- lsblk";              lsblk "$DEV" || true
    echo "--- slot register";      { have devmem && devmem 0x02390024; } || true
    echo "--- fw_printenv";        { have fw_printenv && fw_printenv; } 2>&1 || true
    echo "--- mounts";             grep mmcblk /proc/mounts || true
  } > "$WORK/pre-state.txt"

  say "== backing up the whole pre-rootfs span ($ROOT_OFF bytes)"
  dd if="$DEV" of="$WORK/pre-layout.img" bs=4096 count=$(( ROOT_OFF / 4096 )) \
     status=none iflag=fullblock conv=fsync
  drop_caches
  local onmedium onfile
  onmedium=$(hash_span 0 "$ROOT_OFF")
  onfile=$(hash_file "$WORK/pre-layout.img")
  [ "$onmedium" = "$onfile" ] \
    || die "backup does not match the medium ($onfile != $onmedium)"
  say "  pre-layout.img sha256 $onfile  (verified against the medium)"
  echo "$onfile  pre-layout.img" > "$WORK/pre-layout.img.sha256"

  say "== backing up /boot as files"
  rm -rf "$WORK/boot-backup"; mkdir -p "$WORK/boot-backup"
  if boot_mounted; then
    cp -a /boot/. "$WORK/boot-backup/"
    ( cd "$WORK/boot-backup" && find . -type f -exec sha256sum {} + ) \
      > "$WORK/boot-backup.sha256"
    say "  $(wc -l < "$WORK/boot-backup.sha256") files"
  else
    say "  /boot is not mounted -- nothing copied (the raw span backup still has it)"
  fi

  say "== backing up the environment"
  fw_printenv > "$WORK/env.txt" 2>/dev/null || say "  fw_printenv failed (recorded anyway)"

  say
  say "backup complete in $WORK. 'restore' puts every byte of it back."
}

# ----------------------------------------------------------------- write ---
# name off size file  -- write, drop caches, verify from the medium.
write_span() {
  local name=$1 off=$2 size=$3 file=$4
  local len
  len=$(stat -c %s "$file")
  check_span "$name" "$off" "$size"
  [ "$len" -le "$size" ] || die "$name: image is $len B, partition is $size B"
  [ $(( len % 4096 )) -eq 0 ] || die "$name: image length $len is not a 4 KiB multiple"

  say "-- $name: $len B -> $DEV @ $off (0x$(printf %X "$off"))"
  dd if="$file" of="$DEV" bs=4096 seek=$(( off / 4096 )) \
     status=none conv=fsync,notrunc iflag=fullblock
  drop_caches
  local want got
  want=$(hash_file "$file")
  got=$(hash_span "$off" "$len")
  [ "$want" = "$got" ] || die "$name: read-back mismatch ($got != $want)"
  say "   verified from the medium: $want"
  printf '%s  %s @%s len %s\n' "$want" "$name" "$off" "$len" >> "$WORK/written.sha256"
}

cmd_write() {
  check_root_start
  need_images
  [ -r "$WORK/pre-layout.img.sha256" ] || die "run 'backup' first"
  mkdir -p "$WORK"
  : > "$WORK/written.sha256"

  # `boot` is written last of the four and it is the one that destroys the old
  # /boot, so unmount before anything.
  if boot_mounted; then
    say "== unmounting /boot"
    umount /boot || die "could not unmount /boot (something is holding it open)"
  fi

  say "== decompressing the /boot filesystem image"
  gunzip -c "$IMAGES/bootfs.ext4.gz" > "$WORK/bootfs.ext4"

  say
  say "== writing the new layout (everything except p1)"
  write_span atf   "$ATF_OFF"   "$ATF_SIZE"   "$IMAGES/atf.bin"
  write_span uboot "$UBOOT_OFF" "$UBOOT_SIZE" "$IMAGES/uboot.bin"
  write_span env   "$ENV_OFF"   "$ENV_SIZE"   "$IMAGES/env.bin"
  write_span boot  "$BOOT_OFF"  "$BOOT_SIZE"  "$WORK/bootfs.ext4"
  rm -f "$WORK/bootfs.ext4"

  say
  say "=========================================================================="
  say "  THE BOARD CANNOT BOOT RIGHT NOW."
  say
  say "  The old atf (0x140000) and uboot (0x1C0000) partitions are inside the"
  say "  span just written, and both A/B copies are gone. The vendor SPL still"
  say "  in p1 would read BL31 and U-Boot from those addresses. Do not reboot"
  say "  and do not power-cycle."
  say
  say "  Forward -- the ONE-WAY step, only with the coordinator's go:"
  say "      $0 spl --i-have-the-go"
  say "  which runs:"
  say "      dd if=$IMAGES/spl.bin of=$DEV bs=4096 seek=$(( SPL_OFF / 4096 )) \\"
  say "         conv=fsync,notrunc"
  say
  say "  Back:"
  say "      $0 restore"
  say "=========================================================================="
  cmd_status
}

# ------------------------------------------------------------------- spl ---
cmd_spl() {
  [ "${1:-}" = "--i-have-the-go" ] \
    || die "writing p1 is one-way (a bad SPL means AXDL). Pass --i-have-the-go."
  check_root_start
  need_images
  [ -r "$WORK/pre-layout.img.sha256" ] || die "run 'backup' first"

  say "== pre-state of p1"
  say "   on the medium: $(hash_span "$SPL_OFF" "$SPL_SIZE")"
  say "   new image:     $(hash_file "$IMAGES/spl.bin")"

  write_span spl "$SPL_OFF" "$SPL_SIZE" "$IMAGES/spl.bin"

  say
  say "p1 written and verified. The next boot runs the new first-stage loader."
  say "Reboot when ready; expect ~2 min to SSH."
}

# --------------------------------------------------------------- restore ---
cmd_restore() {
  [ -r "$WORK/pre-layout.img" ] || die "no backup at $WORK/pre-layout.img"
  local want
  want=$(cut -d' ' -f1 < "$WORK/pre-layout.img.sha256")
  [ "$(hash_file "$WORK/pre-layout.img")" = "$want" ] \
    || die "the backup file itself is corrupt; do NOT write it"

  if boot_mounted; then umount /boot || true; fi

  say "== restoring $ROOT_OFF bytes from $WORK/pre-layout.img"
  dd if="$WORK/pre-layout.img" of="$DEV" bs=4096 count=$(( ROOT_OFF / 4096 )) \
     status=none conv=fsync,notrunc iflag=fullblock
  drop_caches
  local got
  got=$(hash_span 0 "$ROOT_OFF")
  [ "$got" = "$want" ] || die "restore read-back mismatch ($got != $want)"
  say "   verified from the medium: $got"
  say
  say "The vendor layout is back, byte for byte. Reboot to use it."
}

# ---------------------------------------------------------------- status ---
cmd_status() {
  drop_caches
  say
  say "on the medium now:"
  printf '  %-6s %-12s %-12s %s\n' part offset size sha256
  for row in \
    "spl $SPL_OFF $SPL_SIZE" \
    "atf $ATF_OFF $ATF_SIZE" \
    "uboot $UBOOT_OFF $UBOOT_SIZE" \
    "env $ENV_OFF $ENV_SIZE"; do
    set -- $row
    printf '  %-6s 0x%-10X %-12s %s\n' "$1" "$2" "$3" "$(hash_span "$2" "$3")"
  done
  # `boot` is 275 MiB; hash its first 4 MiB (superblock + the first group's
  # metadata), which is enough to tell an ext4 from a FAT32 or from garbage.
  printf '  %-6s 0x%-10X %-12s %s (first 4 MiB)\n' \
    boot "$BOOT_OFF" "$BOOT_SIZE" "$(hash_span "$BOOT_OFF" $((4*1024*1024)))"
  say
  say "after the reboot the oracle is:"
  say "  /proc/cmdline carries  $CLAUSE"
  say "  lsblk shows six partitions, root on $NEW_ROOT_DEV"
  say "  /etc/fw_env.config is  $FW_ENV"
}

# ----------------------------------------------------------------- flags ---
# The new /boot is built by the flake and carries `ver`, the extlinux configs,
# the kernel and the dtb -- but not the per-device runtime flags NanoKVM-Server
# writes there (usb.ncm, usb.disk0, eth.nodhcp, hostname, ...). Those are in
# the backup; put them back once the new /boot is mounted.
cmd_flags() {
  boot_mounted || die "/boot is not mounted (nixos-rebuild to the minimal-layout system first)"
  [ -d "$WORK/boot-backup" ] || die "no $WORK/boot-backup"
  local n=0
  for f in "$WORK"/boot-backup/*; do
    [ -f "$f" ] || continue
    case "${f##*/}" in
      ver|Image|*.dtb) continue ;;   # rebuilt by the flake, not per-device
    esac
    cp -a "$f" /boot/ && n=$(( n + 1 ))
    say "  restored ${f##*/}"
  done
  sync
  say "$n runtime flag file(s) restored to /boot"
}

case "${1:-}" in
  backup)  shift; cmd_backup "$@" ;;
  flags)   shift; cmd_flags "$@" ;;
  write)   shift; cmd_write "$@" ;;
  spl)     shift; cmd_spl "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  status)  shift; cmd_status "$@" ;;
  *) sed -n "2,28p" "$0" >&2; exit 2 ;;
esac
