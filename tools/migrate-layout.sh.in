#!/usr/bin/env bash
# ===========================================================================
# In-place eMMC layout migration, run FROM the running appliance (#89 rung 4).
#
# Turns the vendor's 17-partition A/B map into two logical devices -- `spl`,
# the 768 KiB the BootROM owns, and `disk`, which carries a real GPT -- WITHOUT
# moving the root filesystem: both layouts start `rootfs` at the same byte, so
# everything written here lands inside the span the old p1-p16 occupied (plus
# the last 32 KiB of the device, where the alternate GPT header must live).
#
# Every number below is substituted from nixos/lib/emmc-layout.nix by
# pkgs/migrate-layout.nix. Do not edit them here.
#
# THE ONE-WAY STEP IS `spl`, AND IT IS LAST. Until p1 is written the board's
# first-stage loader is still the vendor SPL, which reads BL31 and U-Boot from
# the OLD offsets -- and the `write` phase has overwritten those. So between
# `write` and `spl` the board cannot boot, and the only ways out are `spl`
# (forward) or `restore` (back). Do not power-cycle in that window. After p1
# is written the only way back is AXDL.
#
#   migrate-layout backup    save the whole pre-migration span + /boot + env
#   migrate-layout write     the GPT, atf, uboot, env, boot -- everything but p1
#   migrate-layout spl       write the SPL  (requires --i-have-the-go)
#   migrate-layout restore   put the saved bytes back, exactly
#   migrate-layout status    what is on the medium right now
#   migrate-layout flags     after the reboot: copy the server's runtime flag
#                            files back into the fresh /boot
# ===========================================================================
set -euo pipefail

DEV=/dev/mmcblk0
WORK=${MIGRATE_WORK:-/root/rung4}
IMAGES=${MIGRATE_IMAGES:-}

# ---- the layout, substituted from nixos/lib/emmc-layout.nix ---------------
DEVICE_BYTES=@DEVICE_BYTES@
SPL_OFF=@SPL_OFF@;   SPL_SIZE=@SPL_SIZE@
ROOT_OFF=@ROOT_OFF@
ALT_OFF=@ALT_OFF@;   ALT_SIZE=@ALT_SIZE@
NEW_ROOT_DEV=@NEW_ROOT_DEV@
OLD_ROOT_DEV=@OLD_ROOT_DEV@
CLAUSE="@CLAUSE@"
FW_ENV="@FW_ENV@"
GPT_BASE_LBA=@GPT_BASE_LBA@

# name offset size image   -- everything the `write` phase puts down, in order.
# `spl` is deliberately NOT here; it is the gate.
REGIONS="@REGIONS@"

say() { printf '%s\n' "$*"; }
die() { printf 'migrate-layout: %s\n' "$*" >&2; exit 1; }

# The appliance's PATH, not a Nix closure: this script is copied to an aarch64
# board and a substituted x86-64 store path would be useless there. Anything
# optional is guarded.
have() { command -v "$1" >/dev/null 2>&1; }
boot_mounted() { grep -q ' /boot ' /proc/mounts; }

drop_caches() { sync; echo 3 > /proc/sys/vm/drop_caches; }

# sha256 of a byte range read back FROM THE MEDIUM (never the page cache).
hash_span() { # off len
  dd if="$DEV" bs=4096 skip=$(( $1 / 4096 )) count=$(( $2 / 4096 )) \
     status=none iflag=fullblock | sha256sum | cut -d' ' -f1
}

hash_file() { sha256sum "$1" | cut -d' ' -f1; }

# Refuse any write that could reach the root filesystem or the ROM's region.
check_span() { # name off len
  local n=$1 off=$2 len=$3
  [ $(( off % 4096 )) -eq 0 ] || die "$n: offset $off is not 4 KiB aligned"
  [ $(( off + len )) -le "$DEVICE_BYTES" ] || die "$n: runs off the end of the device"
  if [ "$off" -lt "$ROOT_OFF" ]; then
    [ "$off" -ge "$SPL_SIZE" ] || die "$n: $off is inside the BootROM's region"
    [ $(( off + len )) -le "$ROOT_OFF" ] \
      || die "$n: $off+$len ends at $(( off + len )), past the rootfs start $ROOT_OFF"
  else
    # The only thing allowed past the rootfs start is the alternate GPT, and
    # only in the device's last sectors.
    [ "$off" = "$ALT_OFF" ] || die "$n: $off is inside the root filesystem"
  fi
}

# The two invariants the whole migration rests on.
check_device() {
  local got
  got=$(blockdev --getsize64 "$DEV")
  [ "$got" = "$DEVICE_BYTES" ] \
    || die "$DEV is $got B, the layout was generated for $DEVICE_BYTES B -- WRONG BOARD"
  say "  device size $got B -- matches the layout"

  local want=$(( ROOT_OFF / 512 ))
  for p in "${OLD_ROOT_DEV##*/}" "${NEW_ROOT_DEV##*/}"; do
    if [ -r "/sys/class/block/$p/start" ]; then
      got=$(cat "/sys/class/block/$p/start")
      [ "$got" = "$want" ] \
        || die "$p starts at sector $got, expected $want -- WRONG LAYOUT"
      say "  root partition $p starts at sector $got (0x$(printf %X "$ROOT_OFF")) -- as expected"
      return 0
    fi
  done
  die "neither $OLD_ROOT_DEV nor $NEW_ROOT_DEV exists; refusing to touch $DEV"
}

need_images() {
  [ -n "$IMAGES" ] || IMAGES=$(dirname "$0")/../images
  local f
  while read -r _ _ _ f; do
    [ -n "$f" ] || continue
    [ -r "$IMAGES/$f" ] || die "missing image $IMAGES/$f (set MIGRATE_IMAGES)"
  done <<< "$REGIONS"
  [ -r "$IMAGES/spl.bin" ] || die "missing image $IMAGES/spl.bin"
  say "images: $IMAGES"
}

# ---------------------------------------------------------------- backup ---
cmd_backup() {
  check_device
  mkdir -p "$WORK"

  say "== recording the pre-migration state"
  {
    date -Is
    echo "--- /proc/cmdline";      cat /proc/cmdline
    echo "--- lsblk";              lsblk "$DEV" || true
    echo "--- slot register";      { have devmem && devmem 0x02390024; } || true
    echo "--- fw_printenv";        { have fw_printenv && fw_printenv; } 2>&1 || true
    echo "--- mounts";             grep mmcblk /proc/mounts || true
    echo "--- rootfs geometry";    dumpe2fs -h "$OLD_ROOT_DEV" 2>/dev/null | grep -iE "block count|block size"
  } > "$WORK/pre-state.txt"

  say "== backing up the whole pre-rootfs span ($ROOT_OFF bytes)"
  dd if="$DEV" of="$WORK/pre-layout.img" bs=4096 count=$(( ROOT_OFF / 4096 )) \
     status=none iflag=fullblock conv=fsync
  drop_caches
  local onmedium onfile
  onmedium=$(hash_span 0 "$ROOT_OFF")
  onfile=$(hash_file "$WORK/pre-layout.img")
  [ "$onmedium" = "$onfile" ] \
    || die "backup does not match the medium ($onfile != $onmedium)"
  say "  pre-layout.img sha256 $onfile  (verified against the medium)"
  echo "$onfile  pre-layout.img" > "$WORK/pre-layout.img.sha256"

  # The alternate GPT header goes in the device's last sectors, which today are
  # the tail of the root partition. Those blocks are free (checked before this
  # was ever run), but they still get backed up, because "free" is a property
  # of a filesystem and this is a raw write.
  say "== backing up the last $ALT_SIZE bytes of the device"
  dd if="$DEV" of="$WORK/tail.img" bs=4096 skip=$(( ALT_OFF / 4096 )) \
     status=none iflag=fullblock conv=fsync
  drop_caches
  onmedium=$(hash_span "$ALT_OFF" "$ALT_SIZE")
  onfile=$(hash_file "$WORK/tail.img")
  [ "$onmedium" = "$onfile" ] || die "tail backup does not match the medium"
  say "  tail.img sha256 $onfile  (verified against the medium)"
  echo "$onfile  tail.img" > "$WORK/tail.img.sha256"

  say "== backing up /boot as files"
  rm -rf "$WORK/boot-backup"; mkdir -p "$WORK/boot-backup"
  if boot_mounted; then
    cp -a /boot/. "$WORK/boot-backup/"
    ( cd "$WORK/boot-backup" && find . -type f -exec sha256sum {} + ) \
      > "$WORK/boot-backup.sha256"
    say "  $(wc -l < "$WORK/boot-backup.sha256") files"
  else
    say "  /boot is not mounted -- nothing copied (the raw span backup still has it)"
  fi

  say "== backing up the environment"
  fw_printenv > "$WORK/env.txt" 2>/dev/null || say "  fw_printenv failed (recorded anyway)"

  say
  say "backup complete in $WORK. 'restore' puts every byte of it back."
}

# ----------------------------------------------------------------- write ---
# name off size file  -- write, drop caches, verify from the medium.
write_span() {
  local name=$1 off=$2 size=$3 file=$4
  local len
  len=$(stat -c %s "$file")
  check_span "$name" "$off" "$size"
  [ "$len" -le "$size" ] || die "$name: image is $len B, region is $size B"
  [ $(( len % 4096 )) -eq 0 ] || die "$name: image length $len is not a 4 KiB multiple"

  say "-- $name: $len B -> $DEV @ $off (0x$(printf %X "$off"))"
  dd if="$file" of="$DEV" bs=4096 seek=$(( off / 4096 )) \
     status=none conv=fsync,notrunc iflag=fullblock
  drop_caches
  local want got
  want=$(hash_file "$file")
  got=$(hash_span "$off" "$len")
  [ "$want" = "$got" ] || die "$name: read-back mismatch ($got != $want)"
  say "   verified from the medium: $want"
  printf '%s  %s @%s len %s\n' "$want" "$name" "$off" "$len" >> "$WORK/written.sha256"
}

cmd_write() {
  check_device
  need_images
  [ -r "$WORK/pre-layout.img.sha256" ] || die "run 'backup' first"
  [ -r "$WORK/tail.img.sha256" ] || die "run 'backup' first (no tail backup)"
  mkdir -p "$WORK"
  : > "$WORK/written.sha256"

  # `boot` destroys the old /boot, so unmount before anything.
  if boot_mounted; then
    say "== unmounting /boot"
    umount /boot || die "could not unmount /boot (something is holding it open)"
  fi

  say "== decompressing the /boot filesystem image"
  gunzip -c "$IMAGES/bootfs.ext4.gz" > "$WORK/bootfs.ext4"

  say
  say "== writing the new layout (everything except the SPL)"
  local name off size file src
  while read -r name off size file; do
    [ -n "$name" ] || continue
    case "$file" in
      bootfs.ext4.gz) src="$WORK/bootfs.ext4" ;;
      *)              src="$IMAGES/$file" ;;
    esac
    write_span "$name" "$off" "$size" "$src"
  done <<< "$REGIONS"
  rm -f "$WORK/bootfs.ext4"

  say
  say "=========================================================================="
  say "  THE BOARD CANNOT BOOT RIGHT NOW."
  say
  say "  The old atf (0x140000) and uboot (0x1C0000) partitions are inside the"
  say "  span just written, and both A/B copies are gone. The vendor SPL still"
  say "  in the first 768 KiB would read BL31 and U-Boot from those addresses."
  say "  Do not reboot and do not power-cycle."
  say
  say "  Forward -- the ONE-WAY step, only with the coordinator's go:"
  say "      $0 spl --i-have-the-go"
  say "  which runs:"
  say "      dd if=$IMAGES/spl.bin of=$DEV bs=4096 seek=$(( SPL_OFF / 4096 )) \\"
  say "         conv=fsync,notrunc"
  say
  say "  Back:"
  say "      $0 restore"
  say "=========================================================================="
  cmd_status
}

# ------------------------------------------------------------------- spl ---
cmd_spl() {
  [ "${1:-}" = "--i-have-the-go" ] \
    || die "writing the SPL is one-way (a bad SPL means AXDL). Pass --i-have-the-go."
  check_device
  need_images
  [ -r "$WORK/pre-layout.img.sha256" ] || die "run 'backup' first"

  say "== pre-state of the spl region"
  say "   on the medium: $(hash_span "$SPL_OFF" "$SPL_SIZE")"
  say "   new image:     $(hash_file "$IMAGES/spl.bin")"

  # check_span refuses anything inside the ROM's region, which is exactly what
  # this is, so it is written directly -- with the same verification.
  local len
  len=$(stat -c %s "$IMAGES/spl.bin")
  [ "$len" -le "$SPL_SIZE" ] || die "spl: image is $len B, region is $SPL_SIZE B"
  say "-- spl: $len B -> $DEV @ $SPL_OFF"
  dd if="$IMAGES/spl.bin" of="$DEV" bs=4096 seek=$(( SPL_OFF / 4096 )) \
     status=none conv=fsync,notrunc iflag=fullblock
  drop_caches
  local want got
  want=$(hash_file "$IMAGES/spl.bin")
  got=$(hash_span "$SPL_OFF" "$len")
  [ "$want" = "$got" ] || die "spl: read-back mismatch ($got != $want)"
  say "   verified from the medium: $want"
  printf '%s  spl @%s len %s\n' "$want" "$SPL_OFF" "$len" >> "$WORK/written.sha256"

  say
  say "The SPL is written and verified. The next boot runs the new chain."
  say "Reboot when ready; expect ~3 min to SSH."
}

# --------------------------------------------------------------- restore ---
cmd_restore() {
  [ -r "$WORK/pre-layout.img" ] || die "no backup at $WORK/pre-layout.img"
  local want twant
  want=$(cut -d' ' -f1 < "$WORK/pre-layout.img.sha256")
  twant=$(cut -d' ' -f1 < "$WORK/tail.img.sha256")
  [ "$(hash_file "$WORK/pre-layout.img")" = "$want" ] \
    || die "the backup file itself is corrupt; do NOT write it"
  [ "$(hash_file "$WORK/tail.img")" = "$twant" ] \
    || die "the tail backup is corrupt; do NOT write it"

  if boot_mounted; then umount /boot || true; fi

  say "== restoring $ROOT_OFF bytes from $WORK/pre-layout.img"
  dd if="$WORK/pre-layout.img" of="$DEV" bs=4096 count=$(( ROOT_OFF / 4096 )) \
     status=none conv=fsync,notrunc iflag=fullblock
  say "== restoring the last $ALT_SIZE bytes from $WORK/tail.img"
  dd if="$WORK/tail.img" of="$DEV" bs=4096 seek=$(( ALT_OFF / 4096 )) \
     status=none conv=fsync,notrunc iflag=fullblock
  drop_caches
  local got
  got=$(hash_span 0 "$ROOT_OFF")
  [ "$got" = "$want" ] || die "restore read-back mismatch ($got != $want)"
  got=$(hash_span "$ALT_OFF" "$ALT_SIZE")
  [ "$got" = "$twant" ] || die "tail restore read-back mismatch"
  say "   both verified from the medium"
  say
  say "The vendor layout is back, byte for byte. Reboot to use it."
}

# ---------------------------------------------------------------- status ---
cmd_status() {
  drop_caches
  say
  say "on the medium now:"
  printf '  %-8s %-12s %-12s %s\n' region offset size sha256
  printf '  %-8s 0x%-10X %-12s %s\n' spl "$SPL_OFF" "$SPL_SIZE" "$(hash_span "$SPL_OFF" "$SPL_SIZE")"
  local name off size file
  while read -r name off size file; do
    [ -n "$name" ] || continue
    # `boot` is 272 MiB; hash its first 4 MiB, which is enough to tell an ext4
    # from a FAT32 or from garbage.
    if [ "$size" -gt $((8*1024*1024)) ]; then
      printf '  %-8s 0x%-10X %-12s %s (first 4 MiB)\n' \
        "$name" "$off" "$size" "$(hash_span "$off" $((4*1024*1024)))"
    else
      printf '  %-8s 0x%-10X %-12s %s\n' "$name" "$off" "$size" "$(hash_span "$off" "$size")"
    fi
  done <<< "$REGIONS"
  say
  say "after the reboot the oracle is:"
  say "  /proc/cmdline carries  $CLAUSE"
  say "  lsblk shows mmcblk0p1 (768K) + mmcblk0p2, and loop0p1..5 over p2"
  say "  root on $NEW_ROOT_DEV, /etc/fw_env.config = $FW_ENV"
  say "  sgdisk -p on a loop over mmcblk0p2 lists five named partitions"
  say "  (U-Boot reads the same table at LBA $GPT_BASE_LBA)"
}

# ----------------------------------------------------------------- flags ---
# The new /boot is built by the flake and carries `ver`, the extlinux configs,
# the kernel and the dtb -- but not the per-device runtime flags NanoKVM-Server
# writes there (usb.ncm, usb.disk0, eth.nodhcp, hostname, ...). Those are in
# the backup; put them back once the new /boot is mounted.
cmd_flags() {
  boot_mounted || die "/boot is not mounted (switch to the minimal-layout system first)"
  [ -d "$WORK/boot-backup" ] || die "no $WORK/boot-backup"
  local n=0
  for f in "$WORK"/boot-backup/*; do
    [ -f "$f" ] || continue
    case "${f##*/}" in
      ver|Image|*.dtb) continue ;;   # rebuilt by the flake, not per-device
    esac
    cp -a "$f" /boot/ && n=$(( n + 1 ))
    say "  restored ${f##*/}"
  done
  sync
  say "$n runtime flag file(s) restored to /boot"
}

case "${1:-}" in
  backup)  shift; cmd_backup "$@" ;;
  flags)   shift; cmd_flags "$@" ;;
  write)   shift; cmd_write "$@" ;;
  spl)     shift; cmd_spl "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  status)  shift; cmd_status "$@" ;;
  *) sed -n "2,29p" "$0" >&2; exit 2 ;;
esac
