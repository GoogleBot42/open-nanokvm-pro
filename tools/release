#!/usr/bin/env bash
# Cut a release. Runs entirely against the Gitea source of truth
# (git.neet.dev/zuckerberg/open-nanokvm-pro); the GitHub mirror
# (github.com/GoogleBot42/open-nanokvm-pro) and its Actions do the rest.
#
# Flow (docs/updates.md, "Cutting a release"):
#   1. bump VERSION, commit, push (by hand, before running this);
#   2. tools/release — verifies VERSION/tree/tag state, then tags v<VERSION>
#      on Gitea and pushes the tag;
#   3. the Gitea push mirror replicates the tag to GitHub;
#   4. GitHub Actions (release.yml) fires on the mirrored tag, builds, and
#      publishes the release assets the devices poll.
#
# This script never talks to GitHub with credentials — it only polls the
# public API to confirm the mirrored tag arrived. Never create tags or
# commits on GitHub directly; Gitea is the single source of truth.

set -euo pipefail

GH_REPO="GoogleBot42/open-nanokvm-pro"

die() { echo "error: $*" >&2; exit 1; }

[ -f VERSION ] && [ -f flake.nix ] || die "run from the repo root"

V="$(tr -d '[:space:]' < VERSION)"
echo "$V" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$' \
  || die "VERSION '$V' is not semver"
TAG="v$V"

git diff --quiet && git diff --cached --quiet || die "working tree not clean"
git fetch -q origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] \
  || die "HEAD is not pushed origin/main — commit and push first"
git ls-remote --exit-code --tags origin "refs/tags/${TAG}" >/dev/null \
  && die "tag ${TAG} already exists on Gitea — bump VERSION first"

echo "==> tagging ${TAG} on Gitea"
git tag "$TAG"
git push origin "$TAG"

echo "==> waiting for the mirror to carry ${TAG} to github.com/${GH_REPO}"
for i in $(seq 1 30); do
  if curl -sf "https://api.github.com/repos/${GH_REPO}/git/ref/tags/${TAG}" >/dev/null; then
    echo "OK: tag mirrored. Watch the release build at:"
    echo "    https://github.com/${GH_REPO}/actions"
    exit 0
  fi
  sleep 10
done
echo "Tag not visible on GitHub after 5 min. If the mirror syncs on an" >&2
echo "interval (not on push), wait for it or hit 'Synchronize now' on the" >&2
echo "Gitea mirror settings — the release workflow fires when the tag lands." >&2
